{
    "name":  "dsh-slim-agent",
    "version":  "0.3.0-beta.1",
    "description":  "DSH Slim Agent：面向 1.7B-8B 小参数模型、短上下文（4K-8K）和消费级显卡的轻量级 Agent 能力增强框架。窄主宽子、主动联网、能力密度、重启一次即用。(0.2.3-beta.1)",
    "type":  "module",
    "main":  "index.js",
    "scripts":  {
                    "test":  "node --test",
                    "estimate":  "node benchmark/token-counter.mjs"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/langtune1111/dsh-slim-agent.git"
                   },
    "homepage":  "https://github.com/langtune1111/dsh-slim-agent#readme",
    "bugs":  {
                 "url":  "https://github.com/langtune1111/dsh-slim-agent/issues"
             },
    "exports":  {
                    ".":  "./index.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "index.js",
                  "preset-core.mjs",
                  "cordis.patch.yml",
                  "benchmark",
                  "README.md",
                  "LICENSE"
              ],
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "slim-agent",
                     "8k",
                     "web-search",
                     "subagent",
                     "small-llm"
                 ],
    "license":  "MIT",
    "engines":  {
                    "dsh":  "\u003e=0.2.1-rc.1",
                    "node":  "\u003e=20"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "cordis.patch.yml"
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "*",
                             "@deepseek-ai/dsh-tools":  "*",
                             "@deepseek-ai/schemastery":  "*"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/cordis":  {
                                                             "optional":  true
                                                         },
                                 "@deepseek-ai/dsh-tools":  {
                                                                "optional":  true
                                                            },
                                 "@deepseek-ai/schemastery":  {
                                                                  "optional":  true
                                                              }
                             }
}